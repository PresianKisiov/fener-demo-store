{
  "name": "fener-demo-store",
  "version": "0.1.0",
  "private": true,
  "description": "Demo online store with admin panel, built without Shopify, for learning how the parts connect.",
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/migrate.ts && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:reset": "tsx scripts/reset-db.ts",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "drizzle-orm": "^0.45.4",
    "libphonenumber-js": "^1.13.15",
    "next": "^16.4.0",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
