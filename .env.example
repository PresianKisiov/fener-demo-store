# Copy this file to .env.local and change the values.
# Online (Vercel) you set the same names under Settings > Environment Variables.

# Admin panel login (http://localhost:3000/admin).
# Locally, without these two lines, the login is admin@fener.test / demo1234.
# Online they are required and the password must be at least 10 characters.
ADMIN_EMAIL=admin@fener.test
ADMIN_PASSWORD=demo1234

# Random long string used to sign the admin session cookie. Required online.
SESSION_SECRET=change-me-to-a-long-random-string

# Cloud Postgres (Neon, Supabase). Leave empty to use the local PGlite database.
# On Vercel the Neon integration sets DATABASE_URL and DATABASE_URL_UNPOOLED for you.
# DATABASE_URL=

# Fill the database with ~100 demo orders the first time (true/false).
SEED_DEMO_ORDERS=true

# Optional. Public address of the site; detected automatically if empty.
# APP_URL=http://localhost:3000

# Payment provider for card payments: "mock" (built-in test provider) or "stripe".
PAYMENT_PROVIDER=mock

# Secret shared between the test payment provider and our webhook.
MOCK_WEBHOOK_SECRET=mock-webhook-secret-change-me

# Only when PAYMENT_PROVIDER=stripe (Stripe dashboard, test mode keys).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
